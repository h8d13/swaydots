# requires elev
# set cable down and connect to arg1 SSID and generate ip
# example: cwifi "mynetwork" prompts for password if unkown

cwifi() {
    doas ip link set eth0 down && iwctl station wlan0 connect "$1"
}
lwifi() {
    iwctl station wlan0 scan && iwctl station wlan0 get-networks
}

# set cable back up remove wlan and get ip
ccable() {
    doas ip link set eth0 up && doas ip link set wlan0 down && doas udhcpc -i eth0
}

# media
play() {
	yt-dlp -f bestaudio -g "ytsearch${2:-10}:$1" | xargs mpv --no-video;
}
playv() {
  yt-dlp -f "best[height<=1080]" -g "ytsearch:$*" | xargs mpv
}
